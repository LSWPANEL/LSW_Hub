		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		tbl[key] = v
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		lbl.Text = text .. ": " .. tostring(math.floor(v * 100 + 0.5) / 100)
