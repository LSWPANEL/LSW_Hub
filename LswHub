connect(UIS.InputBegan, function(input, gp)
	if listening and input.UserInputType == Enum.UserInputType.Keyboard then
		local cb = listening
		listening = nil
		cb(input.KeyCode)
		return
	end
	if gp then return end
	if input.KeyCode == Config.ui.toggleKey then
		gui.Enabled = not gui.Enabled
	elseif input.KeyCode == Config.ui.minKey then
		if main.Visible then minimize() else restore() end
	elseif input.KeyCode == B.toggleKey then
		setBotEnabled(not B.enabled)
	end
end)

