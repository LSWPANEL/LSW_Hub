---------------------------------------------------------------- DeathFix (everyone who dies) + auto respawn
-- Deaths are detected three ways:
--   * the Killed remote  ReplicatedStorage.Remote.GameService.GameClient.Killed
--     OnClientEvent(killer, victim, time, info)  -- ANY killer, ANY victim
--   * Humanoid.Died of every player
--   * a player getting a new Character (their old model is now a body)
-- When someone else dies: their character is marked dead (bot/aimbot stop targeting it), their ESP is
-- deleted (nobody else's), and leftover body models are caught by checkNewBodies().
-- When YOU die (victim == you): Auto Spawn waits Delay After Death and presses the spawn key.
local unloaded = false
local deathConns = {} -- player -> Humanoid.Died connection
local respawn = { dueAt = nil, presses = 0 }

do
	local killedHooked = false
	local lastPos = {} -- player -> last known HumanoidRootPart position
	local lastChar = {} -- player -> last Character model we saw

	local function victimInfo(victim)
		local plr, char
		if typeof(victim) == "Instance" then
			if victim:IsA("Player") then
				plr = victim
			elseif victim:IsA("Model") then
				char = victim
				plr = Players:GetPlayerFromCharacter(victim)
			end
		elseif type(victim) == "string" then
			local p = Players:FindFirstChild(victim)
			if p and p:IsA("Player") then plr = p end
		end
		if plr and not char then char = plr.Character end
		return plr, char
	end

	local function scheduleRespawn()
		if not SW.autoSpawn or respawn.dueAt then return end
		respawn.presses = 0
		respawn.dueAt = os.clock() + SW.spawnDelay
		spawnStatus.Text = "Spawn: you died - pressing " .. SW.spawnKey.Name .. " in " .. SW.spawnDelay .. "s"
	end

	-- someone (not me) died. killedByMe = the killer was me.
	local function handleDeath(plr, char, killedByMe, nameHint)
		if plr == lp then return end
		local pos = plr and lastPos[plr] or nil
		if char then
			local r = char:FindFirstChild("HumanoidRootPart")
			if r then pos = r.Position end
			markDead(char)
		end

		local names = {}
		if plr then
			names[plr.Name] = true
			names[plr.DisplayName] = true
		end
		if char then names[char.Name] = true end
		if nameHint then names[nameHint] = true end
		recentDeaths[#recentDeaths + 1] = { t = os.clock(), pos = pos, names = names }

		-- if the bot/aimbot is locked on it right now, drop it this very frame
		local cands = {}
		if botState.sniperTarget then cands[#cands + 1] = botState.sniperTarget end
		if botState.target then cands[#cands + 1] = botState.target end
		if lastAimEntity then cands[#cands + 1] = lastAimEntity end
		for _, e in ipairs(cands) do
			if e.char then
				-- the thing I was locked on when I got the kill is the body, even if the game named it differently
				if killedByMe and not e.plr and pos then
					local r = entityRoot(e)
					if r and (r.Position - pos).Magnitude < 30 then markDead(e.char) end
				end
				if isDeadMarked(e.char) then
					if botState.target == e then botState.target = nil end
					if botState.sniperTarget == e then botState.sniperTarget = nil end
				end
			end
		end

		-- delete THEIR esp only (it comes back hidden-then-visible once they respawn into a new model)
		if plr and (Config.bot.deathFix or Config.aimbot.deathFix) then
			removeEsp(plr)
		end
		if plr then
			plr.CharacterAdded:Once(function(c) deadChars[c] = nil end)
		end

		checkNewBodies()
	end

	local function onKilled(killer, victim)
		local plr, char = victimInfo(victim)
		if plr == lp or victim == lp then
			scheduleRespawn() -- I died
			return
		end
		handleDeath(plr, char, killer == lp, type(victim) == "string" and victim or nil)
	end

	local function hookHumanoid(plr, char)
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum or unloaded then return end
		if deathConns[plr] then deathConns[plr]:Disconnect() end
		deathConns[plr] = hum.Died:Connect(function()
			if plr == lp then
				if not killedHooked then scheduleRespawn() end -- fallback only if the remote isn't available
			else
				handleDeath(plr, char, false)
			end
		end)
	end

	local function watchPlayer(plr)
		if plr.Character then
			lastChar[plr] = plr.Character
			task.spawn(hookHumanoid, plr, plr.Character)
		end
		connect(plr.CharacterAdded, function(c)
			if plr == lp then
				respawn.dueAt = nil -- I'm alive again: stop pressing the spawn key
			else
				local old = lastChar[plr]
				lastChar[plr] = c
				if old and old ~= c then handleDeath(plr, old, false) end -- old model = a body now
			end
			task.spawn(hookHumanoid, plr, c)
		end)
	end
	for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
	connect(Players.PlayerAdded, watchPlayer)
	connect(Players.PlayerRemoving, function(plr)
		lastPos[plr] = nil
		lastChar[plr] = nil
		if deathConns[plr] then
			deathConns[plr]:Disconnect()
			deathConns[plr] = nil
		end
	end)

	-- remember where everyone was, so a death position is known even if the model is already gone
	local lastPosTick = 0
	connect(RunService.Heartbeat, function()
		local now = os.clock()
		if now - lastPosTick < 0.2 then return end
		lastPosTick = now
		for _, plr in ipairs(Players:GetPlayers()) do
			local r = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if r then lastPos[plr] = r.Position end
		end
	end)

	task.spawn(function()
		local ok, ev = pcall(function()
			local r = ReplicatedStorage:WaitForChild("Remote", 15)
			local g = r:WaitForChild("GameService", 15)
			local c = g:WaitForChild("GameClient", 15)
			return c:WaitForChild("Killed", 15)
		end)
		if unloaded then return end
		if ok and ev and ev:IsA("RemoteEvent") then
			killedHooked = true
			connect(ev.OnClientEvent, onKilled)
		else
			warn("[LSW] DeathFix: couldn't find ReplicatedStorage.Remote.GameService.GameClient.Killed")
		end
	end)
end

---------------------------------------------------------------- Firing
-- Real left-mouse input. Tries VirtualInputManager first, then the executor functions
-- mouse1press/mouse1release. If neither exists, a plain LocalScript can't click, and the bot sets
-- the "BotFire" attribute on YOUR PLAYER (lp:SetAttribute) so your own game script can react.
local VIM
pcall(function() VIM = game:GetService("VirtualInputManager") end)
local genv = getfenv()

local lmbUp, fireTool
do
	local m1press, m1release = genv.mouse1press, genv.mouse1release
	local lmbHeld = false
	local lmbVia = nil
	local lmbPressedAt = 0

	local HOLD_TIME = 0.025 -- how long each spam click stays pressed
	local MIN_PERIOD = 0.05 -- fastest spam rate (about 20 clicks per second)

	local function toolMatches(t)
		if B.toolName == "" then return true end
		return string.find(string.lower(t.Name), string.lower(B.toolName), 1, true) ~= nil
	end

	local function getTool(char, allowBackpack)
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") and toolMatches(t) then return t end
		end
		if allowBackpack then
			local backpack = lp:FindFirstChildOfClass("Backpack")
			if backpack then
				for _, t in ipairs(backpack:GetChildren()) do
					if t:IsA("Tool") and toolMatches(t) then return t end
				end
			end
		end
	end

	-- Raw senders. They never trust our own idea of whether the button is down, so a dropped event
	-- can't leave the bot "stuck" thinking it's pressed.
	local function rawDown()
		local m = UIS:GetMouseLocation()
		if VIM then
			local ok = pcall(function() VIM:SendMouseButtonEvent(m.X, m.Y, 0, true, game, 0) end)
			if ok then return "VirtualInputManager" end
		end
		if typeof(m1press) == "function" then
			if pcall(m1press) then return "mouse1press" end
		end
		return nil
	end

	local function rawUp()
		local m = UIS:GetMouseLocation()
		if VIM then
			local ok = pcall(function() VIM:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0) end)
			if ok then return true end
		end
		if typeof(m1release) == "function" then
			if pcall(m1release) then return true end
		end
		return false
	end

	local function lmbDown()
		if lmbHeld then return true end
		local via = rawDown()
		if via then
			lmbHeld = true
			lmbVia = via
			lmbPressedAt = os.clock()
			return true
		end
		return false
	end

	-- force = send a release even if we think it's already up
	function lmbUp(force)
		if not lmbHeld and not force then return end
		lmbHeld = false
		rawUp()
	end

	-- Fires using B.fireMethod. The LMB methods do NOT need a tool at all.
	--   LMB Spam       one clean click (release -> press -> release) every Fire Delay, for as long as
	--                  you are locked on (never faster than ~20 clicks/second)
	--   LMB Hold       holds the button down while on target
	--   Tool Activate  tool:Activate() only (needs a tool)
	--   Both           LMB spam + tool:Activate()
	local CANT_SEND = "CAN'T SEND LMB here (no VirtualInputManager/mouse1press). Hook lp attribute BotFire"

	function fireTool(char, hum, delay, equip)
		local now = os.clock()
		local method = B.fireMethod
		local usesTool = (method == "Tool Activate" or method == "Both")

		local tool = getTool(char, equip and usesTool)
		if tool and tool.Parent ~= char then
			if equip and usesTool then hum:EquipTool(tool) end
			if tool.Parent ~= char then tool = nil end
		end
		if method == "Tool Activate" and not tool then
			botState.fireInfo = "Tool Activate needs a tool - switch Fire Method to LMB Spam"
			return false
		end

		-- keeps the release timer alive: LMB is let go shortly after we lose the target
		if method ~= "Tool Activate" then
			botState.holdActive = true
			botState.holdUntil = now + 0.15
		end

		if method == "LMB Hold" then
			if lmbDown() then
				botState.fireInfo = "LMB held (" .. tostring(lmbVia) .. ")"
				lp:SetAttribute("BotFire", now)
				return true
			end
			botState.fireInfo = CANT_SEND
			return false
		end

		local period = delay
		if method == "LMB Spam" or method == "Both" then period = math.max(delay, MIN_PERIOD) end
		if now - botState.lastAttack < period then return false end
		botState.lastAttack = now

		local sent = false
		if method == "LMB Spam" or method == "Both" then
			rawUp() -- make sure the button is up first so the game always sees a fresh press
			local via = rawDown()
			if via then
				lmbHeld = true
				lmbVia = via
				lmbPressedAt = now
				sent = true
				task.delay(HOLD_TIME, function()
					if lmbHeld and lmbPressedAt == now then lmbUp(true) end
				end)
			end
		end
		if tool and usesTool then tool:Activate() end

		botState.shots += 1

		-- hooks for your own game scripts
		lp:SetAttribute("BotFire", now)
		if tool then tool:SetAttribute("BotFire", now) end

		if method == "Tool Activate" then
			botState.fireInfo = "tool:Activate() shot #" .. botState.shots
		elseif sent then
			botState.fireInfo = "LMB spam (" .. tostring(lmbVia) .. ") shot #" .. botState.shots
		else
			botState.fireInfo = CANT_SEND
		end
		return true
	end
end

local function findSniperTarget(origin)
	local look = camera.CFrame.LookVector
	local best, bestPart, bestScore = nil, nil, math.huge
	for _, e in ipairs(collectTargets(B.teamCheck, B.targetNPCs, B.deathFix)) do
		local part = entityPart(e, B.hitPart)
		if part then
			local dist = (part.Position - origin).Magnitude
			if dist <= B.sniperRange then
				local aimPart = nil
				if not B.visibleOnly or isVisible(part, e.char, origin) then
					aimPart = part
				elseif B.bodyFallback then
					local body = entityRoot(e)
					if body and body ~= part and isVisible(body, e.char, origin) then aimPart = body end
				end
				if aimPart then
					local score
					if B.sniperPriority == "Lowest Health" then
						score = (e.hum and e.hum.Health or 100) + dist / 100000
					elseif B.sniperPriority == "Closest to Crosshair" then
						local dir = (aimPart.Position - camera.CFrame.Position).Unit
						score = math.acos(math.clamp(dir:Dot(look), -1, 1))
					else
						score = dist
					end
					if score < bestScore then best, bestPart, bestScore = e, aimPart, score end
				end
			end
		end
	end
	return best, bestPart
end

local chaseStep, wanderStep
do
	local function requestPath(root, goal)
		if botState.computing then return end
		botState.computing = true
		botState.lastPath = os.clock()
		local token = botState.pathToken
		task.spawn(function()
			local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
			local ok = pcall(function() path:ComputeAsync(root.Position, goal) end)
			if token ~= botState.pathToken then
				botState.computing = false
				return
			end
			if ok and path.Status == Enum.PathStatus.Success then
				botState.waypoints = path:GetWaypoints()
				botState.wpIndex = 2
			else
				botState.waypoints = nil
			end
			botState.computing = false
		end)
	end

	local function followPath(hum, root, fallbackPos)
		local wps = botState.waypoints
		local wp = wps and wps[botState.wpIndex]
		if wp then
			hum:MoveTo(wp.Position)
			if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
			local flat = Vector3.new(wp.Position.X - root.Position.X, 0, wp.Position.Z - root.Position.Z)
			if flat.Magnitude < 3 then botState.wpIndex += 1 end
		else
			hum:MoveTo(fallbackPos)
		end
	end

	function chaseStep(hum, root, tRoot, now)
		if B.usePathfinding then
			if now - botState.lastPath > 0.7 then requestPath(root, tRoot.Position) end
			followPath(hum, root, tRoot.Position)
		else
			hum:MoveTo(tRoot.Position)
		end
	end

	function wanderStep(hum, root, now)
		local needNew = (not botState.wanderPos) or now > botState.wanderUntil
		if not needNew then
			local flat = Vector3.new(botState.wanderPos.X - root.Position.X, 0, botState.wanderPos.Z - root.Position.Z)
			needNew = flat.Magnitude < 4
		end
		if needNew then
			local a = math.random() * math.pi * 2
			local r = math.random(10, math.max(B.wanderRadius, 11))
			botState.wanderPos = root.Position + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			botState.wanderUntil = now + 6
		end
		hum:MoveTo(botState.wanderPos)
	end
end

-- forceRelease: also send a mouse-up even if we think the button is already up (used on disable)
local function stopBotMovement(forceRelease)
	botState.pathToken += 1 -- throws away any path that is still being computed
	botState.waypoints = nil
	botState.target = nil
	botState.sniperTarget = nil
	botState.wanderPos = nil
	botState.holdActive = false
	lmbUp(forceRelease)
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	if h and r then
		h:Move(Vector3.zero, false)
		h:MoveTo(r.Position)
	end
end

-- Movement + melee logic (aiming/firing for sniper style happens in the render step below)
connect(RunService.Heartbeat, function()
	if not B.enabled then
		if botState.wasActive then
			botState.wasActive = false
			botState.stopUntil = os.clock() + 0.4
			stopBotMovement(true)
		elseif os.clock() < botState.stopUntil then
			stopBotMovement() -- keep cancelling movement for a moment so it really stops
		end
		return
	end
	botState.wasActive = true

	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and root) or hum.Health <= 0 then
		setStatus("waiting for respawn")
		botState.waypoints = nil
		return
	end
	local now = os.clock()

	if now - botState.lastScan > 0.25 then
		botState.lastScan = now
		botState.target = findBotTarget(root)
	end

	local tAlive = botState.target ~= nil and entityAlive(botState.target, B.deathFix)
	local tRoot = tAlive and entityRoot(botState.target) or nil
	local moving = false

	if B.style == "Sniper" then
		if botState.sniperTarget then
			hum:MoveTo(root.Position) -- hold still while shooting
		else
			local mode = B.sniperMove
			if mode == "Hunt" and tRoot then
				setStatus("hunting " .. botState.target.name)
				chaseStep(hum, root, tRoot, now)
				moving = true
			elseif mode == "Wander" or (mode == "Hunt" and B.wander) then
				botState.waypoints = nil
				setStatus("wandering")
				wanderStep(hum, root, now)
				moving = true
			else
				setStatus("scanning")
			end
		end
	else
		if tRoot then
			local name = botState.target.name
			local dist = (tRoot.Position - root.Position).Magnitude
			if dist <= B.attackRange then
				setStatus("attacking " .. name)
				if dist > B.attackRange * 0.5 then
					hum:MoveTo(tRoot.Position)
					moving = true
				else
					hum:MoveTo(root.Position)
				end
				faceFlat(root, tRoot.Position)
				fireTool(char, hum, B.attackDelay, B.autoEquip)
			else
				setStatus("chasing " .. name)
				chaseStep(hum, root, tRoot, now)
				moving = true
			end
		else
			botState.waypoints = nil
			if B.wander then
				setStatus("wandering")
				wanderStep(hum, root, now)
				moving = true
			else
				setStatus("idle (no target)")
			end
		end
	end

	-- stuck detection: if we should be moving but barely moved, jump (and pick a new wander spot)
	if moving then
		if now - botState.lastStuckCheck > 0.6 then
			if botState.lastPos and (root.Position - botState.lastPos).Magnitude < 0.6 then
				hum.Jump = true
				botState.wanderUntil = 0
			end
			botState.lastPos = root.Position
			botState.lastStuckCheck = now
		end
	else
		botState.lastPos = nil
	end
end)

---------------------------------------------------------------- Auto spawn (spam key) + bhop
do
	local keypressFn, keyreleaseFn = genv.keypress, genv.keyrelease

	-- presses and releases a key; returns how it was sent, or nil if it couldn't be
	local function sendKey(kc)
		if VIM then
			local ok = pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
			if ok then
				task.delay(0.02, function()
					pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
				end)
				return "VirtualInputManager"
			end
		end
		if typeof(keypressFn) == "function" and typeof(keyreleaseFn) == "function" then
			local v = kc.Value
			if v >= 97 and v <= 122 then v -= 32 end -- letters: Roblox lowercase -> virtual-key code
			local ok = pcall(keypressFn, v)
			if ok then
				task.delay(0.02, function() pcall(keyreleaseFn, v) end)
				return "keypress"
			end
		end
		return nil
	end

	connect(RunService.Heartbeat, function()
		local now = os.clock()
		local c = lp.Character
		local hum = c and c:FindFirstChildOfClass("Humanoid")

		-- Auto Spawn: nothing happens until the Killed remote says I died (see DeathFix section)
		if not SW.autoSpawn then respawn.dueAt = nil end
		if SW.autoSpawn and respawn.dueAt and now >= respawn.dueAt then
			local via = sendKey(SW.spawnKey)
			respawn.presses += 1
			lp:SetAttribute("BotSpawn", now) -- hook for your own game script
			if via then
				spawnStatus.Text = "Spawn: pressed " .. SW.spawnKey.Name .. " #" .. respawn.presses .. " (" .. via .. ")"
			else
				spawnStatus.Text = "Spawn: CAN'T SEND KEY here. Hook lp attribute BotSpawn"
			end
			if SW.spawnRetry and respawn.presses < 6 then
				respawn.dueAt = now + SW.spawnInterval
			else
				respawn.dueAt = nil
			end
		end

		if SW.bhop and hum and hum.Health > 0 then
			local holding = (not SW.bhopHoldSpace) or UIS:IsKeyDown(Enum.KeyCode.Space)
			if holding and not UIS:GetFocusedTextBox() and hum.FloorMaterial ~= Enum.Material.Air then
				hum.Jump = true
			end
		end
	end)
end

---------------------------------------------------------------- Main loop
RunService:BindToRenderStep("LSW_Main", Enum.RenderPriority.Camera.Value + 1, function(dt)
	updateRainbow()
	updateSnow(dt)

	camera = Workspace.CurrentCamera
	if not camera then return end

	-- FOV circle
	local showCircle = A.enabled and A.showFov
	fovCircle.Visible = showCircle
	if showCircle then
		local m = UIS:GetMouseLocation()
		fovCircle.Size = UDim2.fromOffset(A.fov * 2, A.fov * 2)
		fovCircle.Position = UDim2.fromOffset(m.X, m.Y)
		fovStroke.Color = A.fovColor
	end

	-- Sniper bot: the moment an enemy is visible -> snap onto them and spam-fire while locked on
	botState.sniperTarget = nil
	if B.enabled and B.style == "Sniper" then
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")
		if hum and root and hum.Health > 0 then
			local origin = head and head.Position or camera.CFrame.Position
			local plr, part = findSniperTarget(origin)
			if plr and part then
				botState.sniperTarget = plr
				snapCameraTo(part.Position)
				faceFlat(root, part.Position)
				fireTool(char, hum, B.fireDelay, B.autoEquip)
				setStatus("sniping " .. plr.name .. " | " .. tostring(botState.fireInfo or "..."))

				-- stuck-lock guard: a NON-player target with a Humanoid whose health never changes while
				-- we shoot it for 4+ seconds is a leftover body / unhittable ghost -> mark it dead
				if B.deathFix and not plr.plr and plr.hum then
					local t2 = os.clock()
					if botState.lockChar ~= plr.char then
						botState.lockChar = plr.char
						botState.lockSince = t2
						botState.lockHp = plr.hum.Health
					elseif plr.hum.Health ~= botState.lockHp then
						botState.lockSince = t2
						botState.lockHp = plr.hum.Health
					elseif t2 - botState.lockSince > 4 then
						markDead(plr.char)
						botState.lockChar = nil
					end
				else
					botState.lockChar = nil
				end
			else
				botState.lockChar = nil
			end
		end
	end

	-- Aimbot (player-controlled)
	if A.enabled and isAiming() then
		local target = getTarget()
		if target then
			if A.snap then
				snapCameraTo(target.Position)
			else
				local goal = CFrame.lookAt(camera.CFrame.Position, target.Position)
				camera.CFrame = camera.CFrame:Lerp(goal, 1 / math.max(A.smooth, 1))
			end
			if A.autoFire then
				local c = lp.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				if c and h then fireTool(c, h, A.fireDelay, false) end
			end
		end
	end

	-- release a held LMB shortly after we lost the target
	if botState.holdActive and os.clock() > botState.holdUntil then
		botState.holdActive = false
		lmbUp(true)
	end

	-- ESP
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			if not espCache[plr] then createEsp(plr) end
			updateEsp(plr, espCache[plr])
		end
	end
end)

