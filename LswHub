	if show and E.wallCheck then
		if not (isVisible(root, char) or (head and isVisible(head, char))) then show = false end
	end

	local showText = E.names or E.health or E.distance
	e.hl.Enabled = show and E.highlight
	e.bb.Enabled = show and showText
