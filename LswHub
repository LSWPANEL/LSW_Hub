---------------------------------------------------------------- Preset storage
-- Where presets are kept:
--   1) executor environments: writefile/readfile -> LSW_Presets.json
--   2) normal game: DataStore through the LSW_Preset RemoteFunction
--      (add LSW_PresetServer.lua to ServerScriptService)
--   3) neither: presets only work for the current session (nothing is stored)
local Storage = { kind = "none" }
do
	local FILE_NAME = "LSW_Presets.json"
	local env = getfenv()
	local wf, rf, isf = env.writefile, env.readfile, env.isfile
	if typeof(wf) == "function" and typeof(rf) == "function" then
		Storage.kind = "file"
		function Storage.read()
			if typeof(isf) == "function" then
				local ok, exists = pcall(isf, FILE_NAME)
				if ok and not exists then return nil end
			end
			local ok, data = pcall(rf, FILE_NAME)
			if ok and type(data) == "string" then return data end
			return nil
		end
		function Storage.write(str)
			return (pcall(wf, FILE_NAME, str))
		end
	else
		local remote = ReplicatedStorage:WaitForChild("LSW_Preset", 2)
		if remote and remote:IsA("RemoteFunction") then
			Storage.kind = "datastore"
			function Storage.read()
				local ok, res = pcall(function() return remote:InvokeServer("load") end)
				if ok and type(res) == "string" then return res end
				return nil
			end
			function Storage.write(str)
				local ok, res = pcall(function() return remote:InvokeServer("save", str) end)
				return ok and res == true
			end
		else
			function Storage.read() return nil end
			function Storage.write() return false end
		end
	end
end

-- snapshot / applySettings / writeBlob / getBlob are used by other sections; the rest stays private
local snapshot, applySettings, writeBlob, getBlob
do
	local SAVE_SECTIONS = { "aimbot", "hitbox", "esp", "bot", "spawn", "snow", "ui" }
	local SKIP = { bot = { enabled = true } } -- the bot never auto-starts after loading a preset

	local function skipped(sec, key)
		return SKIP[sec] ~= nil and SKIP[sec][key] == true
	end

	local function encodeValue(v)
		local t = typeof(v)
		if t == "Color3" then
			return { c = v:ToHex() }
		elseif t == "EnumItem" then
			return { k = v.Name }
		end
		return v
	end

	-- returns nil if the saved value is unusable
	local function decodeValue(saved, default)
		local dt = typeof(default)
		if dt == "Color3" then
			if type(saved) == "table" and type(saved.c) == "string" then
				local ok, c = pcall(Color3.fromHex, saved.c)
				if ok and typeof(c) == "Color3" then return c end
			end
			return nil
		elseif dt == "EnumItem" then
			if type(saved) == "table" and type(saved.k) == "string" then
				local ok, item = pcall(function() return Enum.KeyCode[saved.k] end)
				if ok and item then return item end
			end
			return nil
		elseif type(saved) == dt then
			return saved
		end
		return nil
	end

	function snapshot()
		local out = { settings = {}, rainbow = {}, scripts = {} }
		for _, sec in ipairs(SAVE_SECTIONS) do
			local s = {}
			for k, v in pairs(Config[sec]) do
				if not skipped(sec, k) then s[k] = encodeValue(v) end
			end
			out.settings[sec] = s
		end
		for i, p in ipairs(rainbowPickers) do out.rainbow[i] = p.on end
		for _, sl in ipairs(slots) do
			if sl.box and sl.interval then
				out.scripts[#out.scripts + 1] = { code = sl.box.Text, interval = sl.interval.Text }
			end
		end
		return out
	end

	function applySettings(settings)
		if type(settings) ~= "table" then return end
		for _, sec in ipairs(SAVE_SECTIONS) do
			local s = settings[sec]
			if type(s) == "table" then
				for k, saved in pairs(s) do
					local cur = Config[sec][k]
					if cur ~= nil and not skipped(sec, k) then
						local v = decodeValue(saved, cur)
						if v ~= nil then Config[sec][k] = v end
					end
				end
			end
		end
		-- old presets used RMB / "LMB Click" names; fire method is LMB Spam now
		local fm = Config.bot.fireMethod
		if type(fm) == "string" then
			local migrated = (fm:gsub("RMB", "LMB"))
			if migrated == "LMB Click" then migrated = "LMB Spam" end
			Config.bot.fireMethod = migrated
		end
	end

	local function readBlob()
		local raw = Storage.read()
		if raw and raw ~= "" then
			local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(data) == "table" then
				if type(data.presets) ~= "table" then data.presets = {} end
				return data
			end
		end
		return { version = 1, presets = {} }
	end

	function writeBlob(blob)
		local ok, str = pcall(function() return HttpService:JSONEncode(blob) end)
		if not ok then return false end
		return Storage.write(str)
	end

	local blobCache
	function getBlob(refresh)
		if refresh or not blobCache then blobCache = readBlob() end
		return blobCache
	end
end

-- phase 1: load the startup preset's settings BEFORE the UI is built, so every control starts correct
local startupData, startupName
do
	local blob = getBlob(true)
	local name = blob.startup
	if type(name) == "string" and type(blob.presets[name]) == "table" then
		startupName = name
		startupData = blob.presets[name]
		Config.preset.name = name
		applySettings(startupData.settings)
	end
end

