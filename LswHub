---------------------------------------------------------------- Tabs
local tabs = {}
local selectTab, themeChanged
do
	local tabNames = { "Scripts", "Aimbot", "ESP", "Bot", "Colors", "Settings" }
	local currentTab = nil

	local tabBar = Instance.new("Frame")
	tabBar.Size = UDim2.new(1, -20, 0, 28)
	tabBar.Position = UDim2.new(0, 10, 0, 40)
	tabBar.BackgroundTransparency = 1
	tabBar.Parent = main

	function selectTab(name)
		for n, t in pairs(tabs) do
			t.page.Visible = (n == name)
			if n == name then
				t.btn.BackgroundColor3 = Config.ui.accent
				t.btn.BackgroundTransparency = 0
			else
				t.btn.BackgroundColor3 = Config.ui.secondary
				t.btn.BackgroundTransparency = Config.ui.secondaryTransparency
			end
		end
		currentTab = name
	end

	function themeChanged()
		refreshSurfaces()
		for _, f in ipairs(accentFns) do f(Config.ui.accent) end
		if currentTab then selectTab(currentTab) end
	end

	for i, name in ipairs(tabNames) do
		local btn = makeButton(tabBar, name, UDim2.new(1 / #tabNames, -4, 1, 0),
			UDim2.new((i - 1) / #tabNames, 0, 0, 0))
		btn.TextScaled = true
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = 13
		limit.Parent = btn

		local page = Instance.new("ScrollingFrame")
		page.Size = UDim2.new(1, -20, 1, -80)
		page.Position = UDim2.new(0, 10, 0, 74)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 5
		page.CanvasSize = UDim2.new()
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.Visible = false
		page.Parent = main

		local l = Instance.new("UIListLayout")
		l.Padding = UDim.new(0, 6)
		l.SortOrder = Enum.SortOrder.LayoutOrder
		l.Parent = page

		tabs[name] = { page = page, btn = btn }
		btn.MouseButton1Click:Connect(function() selectTab(name) end)
	end
end

