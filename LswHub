-- kinds: "bg" (window background), "sec" (secondary), "box" (inputs: darker background)
local surface, refreshSurfaces
do
	local surfaceObjs = {}
	local function surfaceColor(kind)
		if kind == "bg" then return Config.ui.background end
		if kind == "sec" then return Config.ui.secondary end
		return Config.ui.background:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	local function applySurface(obj, kind)
		obj.BackgroundColor3 = surfaceColor(kind)
		if kind == "sec" then
			obj.BackgroundTransparency = Config.ui.secondaryTransparency
		elseif kind == "bg" then
			obj.BackgroundTransparency = Config.ui.transparency
		end
	end
	function surface(obj, kind)
		surfaceObjs[#surfaceObjs + 1] = { obj, kind }
		applySurface(obj, kind)
		return obj
	end
	function refreshSurfaces()
		for _, s in ipairs(surfaceObjs) do
			applySurface(s[1], s[2])
		end
	end
end

