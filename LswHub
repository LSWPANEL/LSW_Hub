---------------------------------------------------------------- Presets (save / load / autosave)
local presetStatus, savePreset, loadPreset, deletePreset, applyExtras, refreshAllUi
do
	local function setPresetStatus(s)
		if presetStatus then presetStatus.Text = s end
	end

	local function cleanName(name)
		name = tostring(name or ""):match("^%s*(.-)%s*$")
		if name == "" then name = "default" end
		return name
	end

	local function listNames(blob)
		local names = {}
		for n in pairs(blob.presets) do names[#names + 1] = n end
		table.sort(names)
		return #names > 0 and table.concat(names, ", ") or "none"
	end

	-- applies the parts of a preset that aren't plain Config values
	function applyExtras(data)
		if type(data.rainbow) == "table" then
			for i, p in ipairs(rainbowPickers) do
				p.on = (data.rainbow[i] == true)
			end
		end
		if type(data.scripts) == "table" then
			clearSlots()
			for _, s in ipairs(data.scripts) do
				if type(s) == "table" and type(s.code) == "string" then
					addSlot(s.code, tostring(s.interval or "1"))
				end
			end
		end
	end

	function refreshAllUi()
		main.Size = SIZES[Config.ui.size] or SIZES.Medium
		setSnowAmount(Config.snow.amount)
		hbRestoreAll()
		for _, fn in ipairs(refreshFns) do fn() end
		themeChanged()
	end

	local saving = false
	function savePreset(name, silent)
		if saving then return false end
		saving = true
		name = cleanName(name)
		local blob = getBlob(false)
		blob.presets[name] = snapshot()
		blob.startup = name
		local ok = writeBlob(blob)
		saving = false
		if ok then
			if not silent then
				setPresetStatus("saved '" .. name .. "' (will load on start) | presets: " .. listNames(blob))
			end
		else
			dirty = true
			setPresetStatus("SAVE FAILED - storage: " .. Storage.kind
				.. (Storage.kind == "none" and " (add LSW_PresetServer.lua to ServerScriptService)" or ""))
		end
		return ok
	end

	function loadPreset(name)
		name = cleanName(name)
		local blob = getBlob(true)
		local data = blob.presets[name]
		if type(data) ~= "table" then
			setPresetStatus("no preset '" .. name .. "' | presets: " .. listNames(blob))
			return
		end
		Config.preset.name = name
		applySettings(data.settings)
		applyExtras(data)
		refreshAllUi()
		setPresetStatus("loaded '" .. name .. "'")
	end

	function deletePreset(name)
		name = cleanName(name)
		local blob = getBlob(true)
		if blob.presets[name] == nil then
			setPresetStatus("no preset '" .. name .. "' | presets: " .. listNames(blob))
			return
		end
		blob.presets[name] = nil
		if blob.startup == name then blob.startup = nil end
		if writeBlob(blob) then
			setPresetStatus("deleted '" .. name .. "' | presets: " .. listNames(blob))
		else
			setPresetStatus("DELETE FAILED - storage: " .. Storage.kind)
		end
	end

	-- autosave: when something changed, write it at most once every 10 seconds
	local lastAuto = 0
	connect(RunService.Heartbeat, function()
		if not dirty or not Config.preset.autoSave or Storage.kind == "none" then return end
		local now = os.clock()
		if now - lastAuto < 10 then return end
		lastAuto = now
		dirty = false
		task.spawn(savePreset, Config.preset.name, true)
	end)
end

