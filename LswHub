---------------------------------------------------------------- Shared checks / helpers
local function isEnemy(plr)
	if plr == lp then return false end
	if lp.Team ~= nil and plr.Team == lp.Team then return false end
	return true
end

-- true if nothing solid sits between origin (default: camera) and the part
local isVisible
do
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.RespectCanCollide = true -- ignore non-collidable parts (triggers etc.)

	function isVisible(part, character, origin)
		origin = origin or camera.CFrame.Position
		rayParams.FilterDescendantsInstances = { lp.Character }
		local result = Workspace:Raycast(origin, part.Position - origin, rayParams)
		if not result then return true end
		return result.Instance:IsDescendantOf(character)
	end
end

local function getAlive(plr)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then return char, hum end
end

local function pickPart(char, name)
	return char:FindFirstChild(name)
		or (name == "UpperTorso" and char:FindFirstChild("Torso"))
		or char:FindFirstChild("HumanoidRootPart")
end

-- Rotates the camera so whatever is under the mouse cursor (screen center if mouse-locked)
-- ends up pointing exactly at pos. Instant, no smoothing.
local function snapCameraTo(pos)
	local cf = camera.CFrame
	local mouse = UIS:GetMouseLocation()
	local a = camera:ViewportPointToRay(mouse.X, mouse.Y).Direction.Unit
	local b = (pos - cf.Position).Unit
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-5 then return end
	local angle = math.acos(math.clamp(a:Dot(b), -1, 1))
	local rot = CFrame.fromAxisAngle(axis.Unit, angle)
	camera.CFrame = CFrame.new(cf.Position) * (rot * cf.Rotation)
end

local function faceFlat(root, pos)
	local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
	if flat.Magnitude > 0.1 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
	end
end

---------------------------------------------------------------- NPC / target helpers
-- A "target" is { char = Model, hum = Humanoid or nil, name = string, plr = Player or nil,
--                 hbPart = the NPC's Hitbox part or nil }.
-- Players come from Players:GetPlayers(); NPCs are found by scanning Workspace twice a second.
--
-- Dead-body rule: if "NPC Hitbox Part Name" is set, an NPC only counts while it HAS that part, and
-- it stops counting the instant that part is removed/unparented (checked every frame, not just on
-- the scan). Leave the name blank to target any NPC model regardless of parts.
local npcList = {}

-- DeathFix: characters/bodies the game's Killed remote said YOU killed. Keyed by the Model, so a
-- respawned player (new Character model) is automatically a valid target again. Weak keys: entries
-- vanish on their own once the body is destroyed.
local deadChars = setmetatable({}, { __mode = "k" })

local function markDead(model)
	local r = model:FindFirstChild("HumanoidRootPart")
	deadChars[model] = { pos = r and r.Position or nil }
end

local function isDeadMarked(char)
	local m = deadChars[char]
	if not m then return false end
	if m.pos then
		local r = char:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - m.pos).Magnitude > 60 then
			-- the same model teleported far away = it respawned (some games reuse the model)
			deadChars[char] = nil
			return false
		end
	end
	return true
end

-- bodies: deaths we saw recently, and when each NPC-looking model first appeared
local recentDeaths = {} -- { t = time, pos = Vector3 or nil, names = { [name] = true } }
local checkNewBodies
do
	local npcFirstSeen = setmetatable({}, { __mode = "k" })

	-- a non-player model counts as a leftover body when, within 10s of someone dying, it either carries
	-- that player's name, or it appeared around the time of the death within 25 studs of where it happened
	function checkNewBodies()
		local now = os.clock()
		for i = #recentDeaths, 1, -1 do
			if now - recentDeaths[i].t > 10 then table.remove(recentDeaths, i) end
		end
		if #recentDeaths == 0 then return end
		for _, e in ipairs(npcList) do
			if not e.plr and not deadChars[e.char] then
				local seen = npcFirstSeen[e.char] or now
				local root = e.hbPart or e.char:FindFirstChild("HumanoidRootPart") or e.char.PrimaryPart
				for _, d in ipairs(recentDeaths) do
					local nameHit = d.names[e.name] == true
					local posHit = root ~= nil and d.pos ~= nil
						and (root.Position - d.pos).Magnitude < 25 and seen >= d.t - 3
					if nameHit or posHit then
						markDead(e.char)
						break
					end
				end
			end
		end
	end

	local function findNpcHitbox(model)
		local hb = Config.bot.npcHitbox
		if not hb or hb == "" then return nil end
		local p = model:FindFirstChild(hb, true)
		if p and p:IsA("BasePart") then return p end
		return nil
	end

	local function scanNpcs()
		table.clear(npcList)
		local BN = Config.bot
		local skip = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character then skip[plr.Character] = true end
		end
		local nameFilter = string.lower(BN.npcName or "")
		local function nameOk(m)
			return nameFilter == "" or string.find(string.lower(m.Name), nameFilter, 1, true) ~= nil
		end
		local needHb = (BN.npcHitbox or "") ~= ""
		local function addNpc(m, hum)
			local hbPart = findNpcHitbox(m)
			if needHb and not hbPart then return end -- no hitbox = dead body / not a real target
			if not npcFirstSeen[m] then npcFirstSeen[m] = os.clock() end
			npcList[#npcList + 1] = { char = m, hum = hum, name = m.Name, hbPart = hbPart }
		end

		local folderName = BN.npcFolder or ""
		if folderName ~= "" then
			-- folder mode: every Model inside the folder counts (a Humanoid isn't required)
			local folder = Workspace:FindFirstChild(folderName, true)
			if not folder then return end
			local counted = {}
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("Model") and not skip[d] and nameOk(d) then
					local nested = false
					local a = d.Parent
					while a and a ~= folder do
						if counted[a] then nested = true break end
						a = a.Parent
					end
					if not nested and d:FindFirstChildWhichIsA("BasePart", true) then
						counted[d] = true
						addNpc(d, d:FindFirstChildOfClass("Humanoid"))
					end
				end
			end
		else
			-- whole-Workspace mode: every Model with a living Humanoid that isn't a player
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d:IsA("Humanoid") then
					local m = d.Parent
					if m and m:IsA("Model") and not skip[m] and d.Health > 0 and nameOk(m) then
						addNpc(m, d)
					end
				end
			end
		end
	end

	local lastNpcScan = 0
	connect(RunService.Heartbeat, function()
		local now = os.clock()
		if now - lastNpcScan < 0.5 then return end
		lastNpcScan = now
		if Config.bot.targetNPCs or Config.aimbot.targetNPCs then
			scanNpcs()
			checkNewBodies()
		elseif #npcList > 0 then
			table.clear(npcList)
		end
	end)
end

local function entityAlive(e, deathFix)
	if not e.char or not e.char:IsDescendantOf(Workspace) then return false end
	if deathFix and isDeadMarked(e.char) then return false end
	if e.hum and e.hum.Health <= 0 then return false end
	if e.hbPart then
		-- the hitbox part vanished -> the NPC is dead: drop it immediately
		if not e.hbPart.Parent or not e.hbPart:IsDescendantOf(Workspace) then return false end
	end
	return true
end

local function entityRoot(e)
	return e.char:FindFirstChild("HumanoidRootPart")
		or e.char.PrimaryPart
		or (e.hbPart and e.hbPart.Parent and e.hbPart)
		or e.char:FindFirstChildWhichIsA("BasePart", true)
end

-- the part to aim at
local function entityPart(e, preferred)
	if e.plr then return pickPart(e.char, preferred) end
	if e.hbPart and e.hbPart.Parent then return e.hbPart end
	return pickPart(e.char, preferred) or entityRoot(e)
end

-- every valid target right now (players, plus NPCs if includeNpcs).
-- deathFix = skip anything the Killed remote marked as dead.
local function collectTargets(teamCheck, includeNpcs, deathFix)
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and (not teamCheck or isEnemy(plr)) then
			local char, hum = getAlive(plr)
			if char and not (deathFix and isDeadMarked(char)) then
				list[#list + 1] = { char = char, hum = hum, name = plr.DisplayName, plr = plr }
			end
		end
	end
	if includeNpcs then
		for _, e in ipairs(npcList) do
			if entityAlive(e, deathFix) then list[#list + 1] = e end
		end
	end
	return list
end

---------------------------------------------------------------- Hitbox expander (client-side)
local hbRestoreAll
do
	local hbOriginal = {} -- part -> original properties

	local function hbRestore(part)
		local o = hbOriginal[part]
		if not o then return end
		if part.Parent then
			part.Size = o.Size
			part.Transparency = o.Transparency
			part.Color = o.Color
			part.CanCollide = o.CanCollide
			part.Massless = o.Massless
		end
		hbOriginal[part] = nil
	end

	function hbRestoreAll()
		for part in pairs(hbOriginal) do hbRestore(part) end
	end

	local function hbApply(part)
		local H = Config.hitbox
		if not hbOriginal[part] then
			hbOriginal[part] = {
				Size = part.Size,
				Transparency = part.Transparency,
				Color = part.Color,
				CanCollide = part.CanCollide,
				Massless = part.Massless,
			}
		end
		local s = Vector3.new(H.size, H.size, H.size)
		if part.Size ~= s then part.Size = s end
		part.Transparency = H.transparency
		part.Color = H.color
		part.CanCollide = false
		part.Massless = true
	end

	local lastHb = 0
	connect(RunService.Heartbeat, function()
		local now = os.clock()
		if now - lastHb < 0.1 then return end
		lastHb = now

		local H = Config.hitbox
		if not H.enabled then
			if next(hbOriginal) then hbRestoreAll() end
			return
		end

		local names = (H.part == "Both") and { "HumanoidRootPart", "Head" } or { H.part }
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= lp then
				local char = plr.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					local want = hum ~= nil and hum.Health > 0 and ((not H.teamCheck) or isEnemy(plr))
					for _, n in ipairs(names) do
						local part = char:FindFirstChild(n)
						if part and part:IsA("BasePart") then
							if want then hbApply(part) else hbRestore(part) end
						end
					end
				end
			end
		end

		for part in pairs(hbOriginal) do
			if not part.Parent then hbOriginal[part] = nil end
		end
	end)
end

