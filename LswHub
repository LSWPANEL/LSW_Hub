-- One-slider color picker: white -> full rainbow -> black, plus hex box and a per-color Rainbow mode
local colorPick
do
	local WHITE_END, BLACK_START = 0.07, 0.93

	local function colorAt(t)
		t = math.clamp(t, 0, 1)
		if t < WHITE_END then
			return Color3.new(1, 1, 1):Lerp(Color3.fromHSV(0, 1, 1), t / WHITE_END)
		elseif t > BLACK_START then
			return Color3.fromHSV(0.92, 1, 1):Lerp(Color3.new(0, 0, 0), (t - BLACK_START) / (1 - BLACK_START))
		end
		return Color3.fromHSV((t - WHITE_END) / (BLACK_START - WHITE_END) * 0.92, 1, 1)
	end

	local SLIDER_SEQ
	do
		local kp = { ColorSequenceKeypoint.new(0, colorAt(0)) }
		for i = 0, 14 do
			local t = WHITE_END + (BLACK_START - WHITE_END) * (i / 14)
			kp[#kp + 1] = ColorSequenceKeypoint.new(math.min(t, 0.999), colorAt(t))
		end
		kp[#kp + 1] = ColorSequenceKeypoint.new(1, colorAt(1))
		SLIDER_SEQ = ColorSequence.new(kp)
	end

	local function posForColor(c)
		local best, bestD = 0, math.huge
		for i = 0, 240 do
			local t = i / 240
			local cc = colorAt(t)
			local d = (cc.R - c.R) ^ 2 + (cc.G - c.G) ^ 2 + (cc.B - c.B) ^ 2
			if d < bestD then best, bestD = t, d end
		end
		return best
	end

	local rainbowCounter = 0

	function colorPick(page, text, tbl, key, onChange)
		local f = row(page, 98)
		local lbl = makeLabel(f, "", UDim2.new(1, -70, 0, 26))
		local preview = Instance.new("Frame")
		preview.Size = UDim2.fromOffset(46, 18)
		preview.Position = UDim2.new(1, -56, 0, 6)
		preview.BorderSizePixel = 0
		preview.Parent = f
		round(preview, 4)

		local hit = Instance.new("TextButton")
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.new(1, -20, 0, 28)
		hit.Position = UDim2.new(0, 10, 0, 28)
		hit.Parent = f

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, 0, 0, 12)
		bar.Position = UDim2.new(0, 0, 0.5, -6)
		bar.BackgroundColor3 = Color3.new(1, 1, 1)
		bar.BorderSizePixel = 0
		bar.Parent = hit
		round(bar, 6)
		local grad = Instance.new("UIGradient")
		grad.Color = SLIDER_SEQ
		grad.Parent = bar

		local marker = Instance.new("Frame")
		marker.Size = UDim2.fromOffset(4, 22)
		marker.BackgroundColor3 = Color3.new(1, 1, 1)
		marker.BorderSizePixel = 0
		marker.ZIndex = 2
		marker.Parent = hit
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.new(0, 0, 0)
		stroke.Thickness = 1
		stroke.Parent = marker

		local hexBox = Instance.new("TextBox")
		hexBox.Size = UDim2.fromOffset(90, 26)
		hexBox.Position = UDim2.new(0, 10, 0, 64)
		hexBox.TextColor3 = Color3.new(1, 1, 1)
		hexBox.Font = Enum.Font.Code
		hexBox.TextSize = 13
		hexBox.ClearTextOnFocus = false
		hexBox.PlaceholderText = "HEX"
		hexBox.Text = ""
		hexBox.Parent = f
		surface(hexBox, "box")
		round(hexBox, 5)

		local rbBtn = makeButton(f, "Rainbow: OFF", UDim2.fromOffset(120, 26), UDim2.new(1, -130, 0, 64), OFFGREY)

		local default = defaultOf(tbl, key)
		local p = { on = false, offset = (rainbowCounter * 0.11) % 1 }
		rainbowCounter += 1
		local pos = posForColor(tbl[key])

		local function refresh()
			local c = tbl[key]
			preview.BackgroundColor3 = c
			lbl.Text = text .. "  #" .. c:ToHex():upper()
			if not hexBox:IsFocused() then hexBox.Text = c:ToHex():upper() end
			marker.Position = UDim2.new(pos, -2, 0.5, -11)
			marker.Visible = not p.on
			rbBtn.Text = p.on and "Rainbow: ON" or "Rainbow: OFF"
			rbBtn.BackgroundColor3 = p.on and ON_COLOR or OFFGREY
		end
		local function commit(fire)
			refresh()
			if fire and onChange then onChange(tbl[key]) end
		end

		function p.apply(c)
			tbl[key] = c
			commit(true)
		end
		function p.setOn(v)
			p.on = v
			if not v then pos = posForColor(tbl[key]) end
			markDirty()
			commit(false)
		end
		rainbowPickers[#rainbowPickers + 1] = p

		refreshFns[#refreshFns + 1] = function()
			pos = posForColor(tbl[key])
			refresh()
		end

		local dragging = false
		local function fromX(x)
			if p.on then return end
			pos = math.clamp((x - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1)
			tbl[key] = colorAt(pos)
			markDirty()
			commit(true)
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				fromX(input.Position.X)
			end
		end)
		connect(UIS.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)
		connect(UIS.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		hexBox.FocusLost:Connect(function()
			local s = string.gsub(hexBox.Text, "#", "")
			local ok, c = pcall(Color3.fromHex, s)
			if ok and typeof(c) == "Color3" then
				p.on = false
				tbl[key] = c
				pos = posForColor(c)
				markDirty()
				commit(true)
			else
				commit(false)
			end
		end)

		rbBtn.MouseButton1Click:Connect(function()
			p.setOn(not p.on)
		end)

		resetFns[#resetFns + 1] = function()
			p.on = false
			tbl[key] = default
			pos = posForColor(default)
			markDirty()
			commit(true)
		end

		refresh()
	end
end

