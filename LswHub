---------------------------------------------------------------- Snowfall
-- Snow layer sits behind everything else in the window (ZIndex 0 vs default 1)
local setSnowAmount, updateSnow
do
	local snowFrame = Instance.new("Frame")
	snowFrame.Name = "Snow"
	snowFrame.BackgroundTransparency = 1
	snowFrame.Size = UDim2.new(1, 0, 1, 0)
	snowFrame.ClipsDescendants = true
	snowFrame.ZIndex = 0
	snowFrame.Parent = main

	local flakes = {}
	local lastSnowColor = nil

	local function snowBounds()
		local w, h = snowFrame.AbsoluteSize.X, snowFrame.AbsoluteSize.Y
		if w < 10 or h < 10 then
			local s = SIZES[Config.ui.size] or SIZES.Medium
			w, h = s.X.Offset, s.Y.Offset
		end
		return w, h
	end

	local function newFlake()
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Config.snow.color
		f.ZIndex = 0
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = f
		f.Parent = snowFrame
		local w, h = snowBounds()
		local d = {
			frame = f,
			x = math.random() * w,
			y = math.random() * h,
			speed = math.random(25, 70),
			size = math.random(20, 50) / 10,
			phase = math.random() * 6.28,
			drift = math.random(8, 22),
		}
		f.BackgroundTransparency = math.random(5, 45) / 100
		flakes[#flakes + 1] = d
	end

	function setSnowAmount(n)
		while #flakes < n do newFlake() end
		while #flakes > n do
			local d = table.remove(flakes)
			d.frame:Destroy()
		end
	end

	function updateSnow(dt)
		local S = Config.snow
		local visible = S.enabled and main.Visible
		snowFrame.Visible = visible
		if not visible then return end
		local w, h = snowBounds()
		local t = os.clock()
		local recolor = (lastSnowColor ~= S.color)
		for _, d in ipairs(flakes) do
			d.y += d.speed * S.speed * dt
			d.x += math.sin(t + d.phase) * d.drift * dt
			if d.y > h + 6 then
				d.y = -6
				d.x = math.random() * w
			end
			if d.x > w + 6 then d.x = -6 elseif d.x < -6 then d.x = w + 6 end
			local sz = d.size * S.size
			d.frame.Size = UDim2.fromOffset(sz, sz)
			d.frame.Position = UDim2.fromOffset(d.x, d.y)
			if recolor then d.frame.BackgroundColor3 = S.color end
		end
		lastSnowColor = S.color
	end

	setSnowAmount(Config.snow.amount)
end

