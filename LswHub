	if e.hl.Adornee ~= char then e.hl.Adornee = char end
	e.hl.FillColor = E.fill
	e.hl.OutlineColor = E.outline
	e.hl.FillTransparency = E.fillTransparency

	local adornee = head or root
	if e.bb.Adornee ~= adornee then e.bb.Adornee = adornee end
	local lines = {}
	if E.names then lines[#lines + 1] = plr.DisplayName end
	if E.health then lines[#lines + 1] = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. " HP" end
	if E.distance then lines[#lines + 1] = math.floor(dist) .. " studs" end
	e.txt.Text = table.concat(lines, "\n")
	e.txt.TextColor3 = E.outline
end

